{
  "name": "tosca-analyzer-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "copy-pyodide": "node scripts/copy-pyodide.mjs",
    "dev": "npm run copy-pyodide && vite",
    "build": "tsc -b && vite build",
    "build:demo": "npm run copy-pyodide && python3 ../backend/scripts/build_demo_data.py && tsc -b && vite build --mode demo && node scripts/make-artifact.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "jspdf": "^2.5.2",
    "pyodide": "^0.27.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3"
  }
}