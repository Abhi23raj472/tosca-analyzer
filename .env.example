# Database: SQLite by default; PostgreSQL in production
DATABASE_URL=postgresql+psycopg://tosca:tosca@db:5432/tosca
# Require "Authorization: Bearer <token>" on every /api call (empty = open, for local use)
API_TOKEN=
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=200

# Tricentis documentation
TOSCA_DOCS_VERSION=2026.1
DOCS_LIVE_CHECK=true

# JIRA (can also be set on the Settings screen)
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_DEPLOYMENT=cloud          # cloud | server
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_STEPS_SOURCE=auto         # auto | xray_cloud | xray_server | zephyr_scale | description
JIRA_ACCEPTANCE_FIELD=         # e.g. customfield_10035
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
ZEPHYR_TOKEN=

# Rally
RALLY_BASE_URL=https://rally1.rallydev.com
RALLY_API_KEY=
